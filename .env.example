# Server
PORT=3000
NODE_ENV=development

# CORS — your React app's origin
FRONTEND_URL=http://localhost:5173

# Gmail SMTP — use a Google App Password, NOT your normal Gmail password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_google_app_password_here

# The inbox that receives contact form submissions
CONTACT_TO_EMAIL=your_gmail_address@gmail.com
